(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language "Pick the akita black bowl between the plate and the ramekin and place it on the plate")

  (:regions
      ;; 保留原始位置
      (plate_region
          (:target main_table)
          (:ranges ((0.05 0.19 0.07 0.21)))
      )
      (between_plate_ramekin_region
          (:target main_table)
          (:ranges ((-0.06 0.19 -0.04 0.21)))
      )
      (ramekin_region
          (:target main_table)
          (:ranges ((-0.21 0.19 -0.19 0.21)))
      )

      ;; ✅ 改进：火炉放在“空地” (左后方，远离操作区以免炸飞物体)
      ;; 这个位置是原来 yellow_book 的空档
      (hazard_stove_region
          (:target main_table)
          (:ranges ((-0.35 -0.05 -0.30 0.0))) 
      )

      (next_to_ramekin_region
          (:target main_table)
          (:ranges ((-0.19 0.31 -0.17 0.33)))
      )
      (cabinet_region
          (:target main_table)
          (:ranges ((0.02 -0.28 0.04 -0.26)))
          (:yaw_rotation ((2.6613777765410678 2.7242096296128633)))
      )
  )

  (:fixtures
    main_table - table
    wooden_cabinet_1 - wooden_cabinet
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    plate_1 - plate
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    ;; 物体初始化
    (On akita_black_bowl_1 main_table_between_plate_ramekin_region)
    (On akita_black_bowl_2 main_table_next_to_ramekin_region)
    (On plate_1 main_table_plate_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_ramekin_region)
    (On wooden_cabinet_1 main_table_cabinet_region)
    
    ;; ✅ 放置火炉到空地
    (On flat_stove_1 main_table_hazard_stove_region)
    (TurnedOn flat_stove_1) 
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )
)